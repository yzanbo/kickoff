{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/foundation/ui/**/*.ts",
    "src/foundation/ui/**/*.tsx",
    "src/features/*/ui/**/*.ts",
    "src/features/*/ui/**/*.tsx",
    "src/app/renderer/**/*.ts",
    "src/app/renderer/**/*.tsx",
    "src/shared/*/events.ts"
  ],
  "exclude": ["**/*.test.ts", "src/**/testing/**", "src/foundation/ui/storage/memoryStorage.ts"]
}
