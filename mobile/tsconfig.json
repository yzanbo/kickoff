{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@/app/shared/*": ["../src/app/shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/shared/**/*.ts", "../src/app/shared/**/*.ts"],
  "exclude": ["node_modules", "../src/shared/**/*.test.ts", "../src/shared/foundation/webGlobals.d.ts"]
}
