{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/shared/**/*.ts"],
  "exclude": ["node_modules", "../src/shared/**/*.test.ts"]
}
