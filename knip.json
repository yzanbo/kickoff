{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/desktop/index.ts",
    "src/app/desktop/preload.ts",
    "src/app/renderer/main.tsx",
    "src/app/core/daemon.ts",
    "src/app/core/hostMain.ts",
    "src/**/*.dbtest.ts",
    "src/features/terminal/core/xtermTypes.d.ts",
    "src/features/*/ui/windowMessages.ts",
    "electron.vite.config.ts",
    "scripts/*.mjs",
    "scripts/refactor/*.mjs",
    "scripts/*.cjs",
    "scripts/hooks/pre*.mjs",
    "scripts/perf/*.mjs",
    "scripts/devtools/*.mjs",
    "scripts/e2e/*.mjs",
    "scripts/e2e/scenarios/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,cjs}"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["sips", "iconutil", "plutil", "pgrep", "ditto"]
}
